---
const { room } = Astro.props;

const statusLabels = {
  available: 'Disponible todo el día',
  partial: 'Disponibilidad parcial',
  occupied: 'No disponible',
};
---

<article class="room-card" data-room-id={room.id}>
  <div class="room-header">
    <h3>{room.name}</h3>
    <span class="capacity">{room.capacity} plazas</span>
  </div>
  <p class="description">{room.description}</p>
  <p class="status" data-status={room.status}>
    <span class="status-dot" aria-hidden="true"></span>
    {statusLabels[room.status]}
  </p>
  <a
    href={`/reservar?room=${room.id}`}
    class="reserve-link"
  >
    Reservar
  </a>
</article>

<style>
  .room-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .room-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }
  .room-header h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }
  .capacity {
    font-size: 12px;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .description {
    margin: 0;
    color: var(--text-secondary);
    font-size: 13px;
  }
  .status {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 13px;
    color: var(--success-text);
  }
  .status[data-status="partial"] {
    color: var(--accent-text);
  }
  .status[data-status="occupied"] {
    color: var(--danger-text);
  }
  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
  .reserve-link {
    display: inline-flex;
    align-self: flex-start;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-primary);
    font-size: 13px;
    background: var(--surface);
  }
  .reserve-link:hover {
    background: var(--background);
  }
  .reserve-link[data-disabled="true"] {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
